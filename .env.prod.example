# Copiar para .env.prod e preencher no painel do Coolify. NUNCA commitar .env.prod.

# --- Obrigatorio ---
# Internal URL do recurso shared-postgres (projeto infrastructure no Coolify).
# Trocar so o nome do banco no fim da URL para /migarden.
# Ex: postgres://USER:PASS@HOST:5432/migarden
DATABASE_URL=

# Chave de assinatura de cookies/sessoes (gerar: bundle exec rails secret)
SECRET_KEY_BASE=

# --- Opcional ---
# Master key do Rails (so se usar config/credentials.yml.enc). Se vazio, tudo via env.
#RAILS_MASTER_KEY=

# --- Telegram (lembretes) ---
# Token do bot criado no @BotFather. Obrigatorio para enviar lembretes.
#TELEGRAM_BOT_TOKEN=

# --- Active Storage (fotos) no Cloudflare R2 ---
# Obrigatorio para upload de fotos em producao. Deixe vazio apenas se nao usar foto.
#R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
#R2_ACCESS_KEY_ID=
#R2_SECRET_ACCESS_KEY=
#R2_BUCKET=migarden

# --- Monitoramento (opcional) ---
#SENTRY_DSN=

# --- Logs no Grafana Loki (opcional) ---
#LOKI_URL=
#LOKI_USERNAME=
#LOKI_TOKEN=
