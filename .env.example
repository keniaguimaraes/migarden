# Database
DATABASE_URL=postgres://postgres:password@db:5432/migarden_development
DATABASE_URL_TEST=postgres://postgres:password@db:5432/migarden_test
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=migarden_development

# Rails
RAILS_ENV=development
PORT=3000
SECRET_KEY_BASE=
RAILS_MASTER_KEY=
PIDFILE=tmp/pids/server.pid
RAILS_MAX_THREADS=5
RAILS_MIN_THREADS=5
RAILS_SERVE_STATIC_FILES=true
RAILS_LOG_TO_STDOUT=true

# Background jobs (Solid Queue requires Redis for scheduled jobs)
REDIS_URL=redis://localhost:6379/1

# Active Storage — Cloudflare R2 (S3-compatible)
ACTIVE_STORAGE_SERVICE=cloudflare_r2
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=migarden

# Monitoring (optional)
SENTRY_DSN=
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=MiGarden

# Log shipping — Grafana Loki (optional)
LOKI_URL=https://<instance>.grafana.net
LOKI_USERNAME=<instance-id>
LOKI_TOKEN=
